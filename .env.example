# Log level for main process
DP_LOG_LEVEL=debug

# Log level for renderer (Vite-injected)
VITE_DP_LOG_LEVEL=debug

# Optional main-process module filter allowlist/denylist
DP_LOG_INCLUDE_MODULES=
DP_LOG_EXCLUDE_MODULES=

# Optional renderer-side filters (Vite-injected)
VITE_DP_LOG_INCLUDE_MODULES=
VITE_DP_LOG_EXCLUDE_MODULES=

