{
    "root": true,
    "env": {
        "browser": true,
        "es6": true,
        "node": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended",
        "plugin:import/recommended",
        "plugin:import/electron",
        "plugin:import/typescript",
        "plugin:react/recommended",
        "plugin:react-hooks/recommended",
        "plugin:jsx-a11y/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module",
        "ecmaFeatures": {
            "jsx": true
        }
    },
    "ignorePatterns": [
        "vite.*.config.ts",
        "my-new-app/**",
        "node_modules/**",
        ".vite/**",
        "out/**",
        "**/*.md",
        "dist/**",
        "build/**"
    ],
    "settings": {
        "import/resolver": {
            "node": {
                "extensions": [".js", ".jsx", ".ts", ".tsx"],
                "paths": ["src"]
            },
            "alias": {
                "map": [["@", "./src"]],
                "extensions": [".js", ".jsx", ".ts", ".tsx"]
            }
        },
        "react": {
            "version": "detect"
        }
    },
    "rules": {
        "no-mixed-spaces-and-tabs": "off",
        "@typescript-eslint/no-explicit-any": "warn",
        "@typescript-eslint/no-unused-vars": [
            "warn",
            {
                "argsIgnorePattern": "^_",
                "varsIgnorePattern": "^_",
                "caughtErrorsIgnorePattern": "^_"
            }
        ],
        "react/react-in-jsx-scope": "off",
        "react/jsx-uses-react": "off",
        "jsx-a11y/anchor-is-valid": "warn",
        "jsx-a11y/click-events-have-key-events": "warn",
        "jsx-a11y/mouse-events-have-key-events": "warn",
        "jsx-a11y/no-static-element-interactions": "warn",
        "jsx-a11y/no-noninteractive-tabindex": "warn",
        "jsx-a11y/label-has-associated-control": "warn",
        "jsx-a11y/alt-text": "warn"
    },
    "overrides": [
        {
            "files": ["src/fronted/features/**/*.{ts,tsx}"],
            "excludedFiles": ["src/fronted/features/**/*Api.ts"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "paths": [
                            {
                                "name": "@/fronted/infrastructure/electron/backendClient",
                                "message": "业务调用请收口到当前 feature 的 *Api.ts 文件。"
                            }
                        ],
                        "patterns": [
                            {
                                "group": ["qa/**", "../qa/**", "../../qa/**", "../../../qa/**"],
                                "message": "产品代码不许 import qa/ 下的用例资产。"
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["src/**/*.{ts,tsx}"],
            "excludedFiles": ["src/fronted/features/**/*.{ts,tsx}"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": ["qa/**", "../qa/**", "../../qa/**", "../../../qa/**"],
                                "message": "产品代码不许 import qa/ 下的用例资产。"
                            }
                        ]
                    }
                ]
            }
        },
        {
            "files": ["qa/**/*.{ts,tsx,mjs,js}"],
            "rules": {
                "no-restricted-imports": [
                    "error",
                    {
                        "patterns": [
                            {
                                "group": [
                                    "@/fronted",
                                    "@/fronted/**",
                                    "@/backend",
                                    "@/backend/**",
                                    "@/app",
                                    "@/app/**",
                                    "@/test",
                                    "@/test/**"
                                ],
                                "message": "qa/ 只依赖 @/common 的类型与常量：运行期契约走 window.__dpDebug 与 URL 参数，不许直接读产品内部实现（产品一重构，用例就跟着烂）。"
                            },
                            {
                                "group": ["**/src/fronted/**", "**/src/backend/**", "**/src/app/**", "**/src/test/**"],
                                "message": "qa/ 不许用相对路径绕到 src 的内部实现；只允许 ../../src/common/**。"
                            }
                        ]
                    }
                ],
                "no-empty-pattern": ["error", { "allowObjectPatternsAsParameters": true }],
                "react-hooks/rules-of-hooks": "off"
            }
        },
        {
            "files": ["src/**/__tests__/**/*.{ts,tsx,js,jsx}", "src/**/*.{test,spec}.{ts,tsx,js,jsx}"],
            "rules": {
                "no-restricted-syntax": [
                    "error",
                    {
                        "selector": "CallExpression[callee.object.name=/^(describe|it|test)$/][callee.property.name='only']",
                        "message": "禁止提交 describe.only / it.only / test.only，调试完请移除。"
                    }
                ]
            }
        }
    ]
}
